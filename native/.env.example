# Backend API base URL
# For simulator: http://localhost:3000/api/v1
# For physical device: use your machine LAN IP, e.g. http://192.168.1.4:3000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1

# Optional: Google Maps API key (if location geocoding is enabled)
# EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# iOS team id for native iOS builds (optional unless you run iOS build/signing)
EXPO_IOS_TEAM_ID=YOUR_TEAM_ID
