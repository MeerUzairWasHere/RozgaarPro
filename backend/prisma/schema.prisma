generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String         @id @default(uuid())
  username                    String?        @unique
  phone                       String         @unique @db.VarChar(15)
  name                        String
  email                       String?        @unique
  role                        Role           @default(USER)
  password                    String
  passwordToken               String?        @db.VarChar(255)
  passwordTokenExpirationDate DateTime?
  verificationToken           String?        @db.VarChar(255)
  isVerified                  Boolean        @default(false)
  verified                    DateTime?
  createdAt                   DateTime       @default(now())
  updatedAt                   DateTime       @updatedAt
  profileCompleted            Boolean        @default(false)
  profileImage                String?
  idImage                     String?
  freelancer                  Freelancer?
  refreshTokens               Token[]
  conversationsAsUser         Conversation[]
  sentMessages                Message[]
  reviews                     Review[]
}

/// /////////////////
/// TOKEN
/// /////////////////
model Token {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  ip           String   @db.VarChar(255)
  userAgent    String   @db.VarChar(255)
  isValid      Boolean  @default(true)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Freelancer {
  id                  String               @id @default(uuid())
  userId              String               @unique
  experience          Decimal              @db.Decimal(4, 1)
  availability        AvailabilityStatus   @default(AVAILABLE)
  phone               String
  description         String?              @db.VarChar(255)
  status              FreelancerStatus     @default(PENDING)
  rating              Float                @default(0)
  primaryProfessionId String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  primaryProfession   Profession           @relation(fields: [primaryProfessionId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations           FreelancerLocation[]
  skills              FreelancerSkill[]
  conversations       Conversation[]
  images              Image[]
  reviews             Review[]
}

model FreelancerLocation {
  id           String     @id @default(uuid())
  freelancerId String
  latitude     Decimal    @db.Decimal(9, 6)
  longitude    Decimal    @db.Decimal(9, 6)
  accuracy     Int?
  recordedAt   DateTime   @default(now())
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@index([freelancerId, recordedAt])
}

model Profession {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  freelancers Freelancer[]
  skills      Skill[]
}

model Skill {
  id           String            @id @default(uuid())
  name         String
  professionId String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  freelancers  FreelancerSkill[]
  profession   Profession        @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([name, professionId])
}

model FreelancerSkill {
  id           String     @id @default(uuid())
  freelancerId String
  skillId      String
  isVerified   Boolean    @default(true)
  createdAt    DateTime   @default(now())
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, skillId])
}

model Conversation {
  id           String     @id @default(uuid())
  userId       String
  freelancerId String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([userId, freelancerId])
  @@index([userId])
  @@index([freelancerId])
}

model Message {
  id             String       @id @default(uuid())
  conversationId String
  senderUserId   String
  body           String       @db.Text
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Image {
  id         String     @id @default(uuid())
  entityId   String
  imageKey   String     @db.VarChar(255)
  altText    String?    @db.VarChar(255)
  createdAt  DateTime   @default(now())
  freelancer Freelancer @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId, createdAt])
}

model Review {
  id           String     @id @default(uuid())
  userId       String
  freelancerId String
  rating       Int
  comment      String?    @db.VarChar(500)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@unique([userId, freelancerId])
  @@index([freelancerId, createdAt])
  @@index([userId])
}

model Company {
  id                     String   @id @default(uuid())
  name                   String   @unique @db.VarChar(255)
  address                String   @db.VarChar(255)
  website                String   @unique @db.VarChar(255)
  phone                  String   @unique @db.VarChar(255)
  email                  String   @unique @db.VarChar(255)
  verified_resend_domain String   @db.VarChar(55)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  FREELANCER
}

enum FreelancerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}
