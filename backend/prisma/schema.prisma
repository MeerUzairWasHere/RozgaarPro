generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

////////////////////
/// ENUMS
////////////////////

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  FREELANCER
}

enum FreelancerStatus {
  PENDING
  APPROVED
  REJECTED
}

////////////////////
/// USER
////////////////////

model User {
  id                          String      @id @default(uuid())
  username                    String?     @unique
  phone                       String      @unique @db.VarChar(15)
  name                        String
  email                       String?     @unique
  role                        Role        @default(USER)
  password                    String
  passwordToken               String?     @db.VarChar(255)
  passwordTokenExpirationDate DateTime?
  verificationToken           String?     @db.VarChar(255)
  isVerified                  Boolean     @default(false)
  verified                    DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  profileCompleted            Boolean     @default(false)
  ProfileApproved             Boolean     @default(false)
  // Relations
  refreshTokens               Token[]
  freelancer                  Freelancer?
  jobs                        Job[]
}

////////////////////
/// TOKEN
////////////////////
model Token {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  ip           String   @db.VarChar(255)
  userAgent    String   @db.VarChar(255)
  isValid      Boolean  @default(true)
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

////////////////////
/// FREELANCER
////////////////////

model Freelancer {
  id         String           @id @default(uuid())
  userId     String           @unique
  experience Int
  phone      String
  status     FreelancerStatus @default(PENDING)
  rating     Float            @default(0)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  // Relations
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills    Skill[]
  jobs      Job[]
  locations FreelancerLocation[]
}

////////////////////
/// FREELANCER LOCATION
////////////////////

model FreelancerLocation {
  id           String @id @default(uuid())
  freelancerId String

  latitude   Decimal  @db.Decimal(9, 6)
  longitude  Decimal  @db.Decimal(9, 6)
  accuracy   Int?
  recordedAt DateTime @default(now())

  // Relations
  freelancer Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@index([freelancerId, recordedAt])
}

////////////////////
/// SKILL
////////////////////

model Skill {
  id         String       @id @default(uuid())
  name       String       @unique
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  freelancer Freelancer[]
}

////////////////////
/// JOB / REQUEST
////////////////////

model Job {
  id           String   @id @default(uuid())
  title        String
  description  String
  location     String
  budget       Float?
  userId       String
  freelancerId String?
  isCompleted  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  freelancer Freelancer? @relation(fields: [freelancerId], references: [id])
}

////////////////////
/// COMPANY (Optional)
////////////////////

model Company {
  id                     String   @id @default(uuid())
  name                   String   @unique @db.VarChar(255)
  address                String   @db.VarChar(255)
  website                String   @unique @db.VarChar(255)
  phone                  String   @unique @db.VarChar(255)
  email                  String   @unique @db.VarChar(255)
  verified_resend_domain String   @db.VarChar(55)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}
