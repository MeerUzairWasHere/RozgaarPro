generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                          String      @id @default(uuid())
  username                    String?     @unique
  phone                       String      @unique @db.VarChar(15)
  name                        String
  email                       String?     @unique
  role                        Role        @default(USER)
  password                    String
  passwordToken               String?     @db.VarChar(255)
  passwordTokenExpirationDate DateTime?
  verificationToken           String?     @db.VarChar(255)
  isVerified                  Boolean     @default(false)
  verified                    DateTime?
  createdAt                   DateTime    @default(now())
  updatedAt                   DateTime    @updatedAt
  profileCompleted            Boolean     @default(false)
  profileImage                String?
  idImage                     String?
  freelancer                  Freelancer?
  refreshTokens               Token[]
}

/// /////////////////
/// TOKEN
/// /////////////////
model Token {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  ip           String   @db.VarChar(255)
  userAgent    String   @db.VarChar(255)
  isValid      Boolean  @default(true)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
}

model Freelancer {
  id                  String               @id @default(uuid())
  userId              String               @unique
  experience          Decimal              @db.Decimal(4, 1)
  availability        AvailabilityStatus   @default(AVAILABLE)
  phone               String
  description         String?              @db.VarChar(255)
  status              FreelancerStatus     @default(PENDING)
  rating              Float                @default(0)
  primaryProfessionId String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  primaryProfession   Profession           @relation(fields: [primaryProfessionId], references: [id])
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  locations           FreelancerLocation[]
  skills              FreelancerSkill[]
}

model FreelancerLocation {
  id           String     @id @default(uuid())
  freelancerId String
  latitude     Decimal    @db.Decimal(9, 6)
  longitude    Decimal    @db.Decimal(9, 6)
  accuracy     Int?
  recordedAt   DateTime   @default(now())
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([latitude, longitude])
  @@index([freelancerId, recordedAt])
}

model Profession {
  id          String       @id @default(uuid())
  name        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  freelancers Freelancer[]
  skills      Skill[]
}

model Skill {
  id           String            @id @default(uuid())
  name         String
  professionId String
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  freelancers  FreelancerSkill[]
  profession   Profession        @relation(fields: [professionId], references: [id], onDelete: Cascade)

  @@unique([name, professionId])
}

model FreelancerSkill {
  id           String     @id @default(uuid())
  freelancerId String
  skillId      String
  isVerified   Boolean    @default(true)
  createdAt    DateTime   @default(now())
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  skill        Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([freelancerId, skillId])
}

model Company {
  id                     String   @id @default(uuid())
  name                   String   @unique @db.VarChar(255)
  address                String   @db.VarChar(255)
  website                String   @unique @db.VarChar(255)
  phone                  String   @unique @db.VarChar(255)
  email                  String   @unique @db.VarChar(255)
  verified_resend_domain String   @db.VarChar(55)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  USER
  FREELANCER
}

enum FreelancerStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  UNAVAILABLE
}
