# App
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000/api/v1

# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public

# Auth / Cookies
COOKIE_SECRET=replace_with_secure_cookie_secret
JWT_SECRET=replace_with_secure_jwt_secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=30d

# Email (Resend)
EMAIL_SERVICE_API_KEY=re_xxxxxxxxxxxxxxxxx

# Twilio Verify
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# AWS (S3 + Rekognition)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace_with_aws_access_key_id
AWS_SECRET_ACCESS_KEY=replace_with_aws_secret_access_key
AWS_S3_PUBLIC_BUCKET=your-public-bucket
AWS_S3_PRIVATE_BUCKET=your-private-bucket

# Remove Background API
IMAGE_API_KEY=replace_with_remove_bg_api_key

# Monitoring
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
